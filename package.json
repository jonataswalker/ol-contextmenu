{
    "name": "ol-contextmenu",
    "version": "6.0.1",
    "description": "Custom Context Menu for Openlayers",
    "keywords": [
        "openlayers",
        "ol",
        "contextmenu",
        "context-menu",
        "right-click",
        "menu",
        "map",
        "gis",
        "geospatial"
    ],
    "type": "module",
    "main": "./dist/ol-contextmenu.umd.cjs",
    "jsdelivr": "./dist/ol-contextmenu.iife.js",
    "module": "./dist/ol-contextmenu.js",
    "browser": "./dist/ol-contextmenu.js",
    "sideEffects": [
        "./dist/ol-contextmenu.js",
        "./dist/ol-contextmenu.umd.cjs",
        "./dist/ol-contextmenu.iife.js"
    ],
    "exports": {
        ".": {
            "types": "./dist/ol-contextmenu.d.ts",
            "import": "./dist/ol-contextmenu.js",
            "require": "./dist/ol-contextmenu.umd.cjs",
            "default": "./dist/ol-contextmenu.js"
        }
    },
    "files": [
        "./dist"
    ],
    "types": "./dist/ol-contextmenu.d.ts",
    "author": "Jonatas Walker",
    "homepage": "https://github.com/jonataswalker/ol-contextmenu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/jonataswalker/ol-contextmenu.git"
    },
    "bugs": {
        "url": "https://github.com/jonataswalker/ol-contextmenu/issues"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "scripts": {
        "dev": "vite",
        "build": "premove ./dist && vite build",
        "preview": "vite preview",
        "lint": "oxlint",
        "lint:fix": "npm run lint -- --fix",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "pretest:types": "npm run build",
        "test:types": "tsc -p tests/types && attw --pack . --ignore-rules false-esm false-export-default && publint",
        "prepare": "husky",
        "release": "release-it --no-npm.publish"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@microsoft/api-extractor": "^7.59.4",
        "@types/node": "^26.6.5",
        "@typescript/typescript6": "^6.0.2",
        "@vitest/browser-webdriverio": "^5.0.0",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "auto-changelog": "^2.7.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "ol": "^10.11.0",
        "oxlint": "^1.89.0",
        "oxlint-config-jwalker": "^0.2.1",
        "oxlint-tsgolint": "^7.0.2005",
        "premove": "^4.0.0",
        "publint": "^0.3.25",
        "release-it": "^21.1.1",
        "sass": "^1.106.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vite-plugin-banner": "^0.8.1",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.5",
        "webdriverio": "^9.32.0"
    },
    "peerDependencies": {
        "ol": "> 7.x <= 10.x"
    },
    "dependencies": {
        "tiny-emitter": "^2.1.0"
    },
    "allowScripts": {
        "geckodriver@6.1.0": true
    }
}
